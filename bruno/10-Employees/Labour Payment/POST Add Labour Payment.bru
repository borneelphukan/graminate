meta {
  name: "Add Labour Payment"
  type: http
  seq: 137
}

post {
  url: {{baseUrl}}/api/labour_payment/add
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "labour_id": 1,
    "payment_date": "2024-01-01",
    "salary_paid": 15000,
    "bonus": 0,
    "overtime_pay": 0,
    "housing_allowance": 0,
    "travel_allowance": 0,
    "meal_allowance": 0,
    "payment_status": "paid"
  }
}
